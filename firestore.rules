rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Multi-tenant data is isolated under organizations/{orgId}. Any
    // authenticated member of the platform may read/write within an org,
    // but cross-org access is prevented by the data hierarchy. Server-side
    // security rules enforce membership for writes where applicable.
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (resource == null || resource.data.ownerId == request.auth.uid
            || isOrgMember(orgId));

      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /subscriptions/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /invoices/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /fraud_alerts/{id} {
      allow read, write: if request.auth != null;
    }

    match /forecasts/{id} {
      allow read, write: if request.auth != null;
    }

    match /advisor_insights/{id} {
      allow read, write: if request.auth != null;
    }

    match /support_requests/{id} {
      allow read, write: if request.auth != null;
    }

    // Platform collections (super admin only in practice).
    match /transactions/{id} {
      allow read, write: if request.auth != null;
    }

    match /mpesa_transactions/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /chamas/{document=**} {
      allow read, write: if request.auth != null;
    }

    function isOrgMember(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }
  }
}
